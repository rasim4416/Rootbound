[ext_resource type="Resource" path="res://data/levels/default_wave_scaling.tres" id="6_scaling"]
[ext_resource type="Script" path="res://scripts/levels/path_activation_rule.gd" id="7_rule"]

[sub_resource type="Resource" id="Rule_p1"]
script = ExtResource("7_rule")
path = ExtResource("2_path")
unlock_from_wave = 1

[sub_resource type="Resource" id="Rule_p2"]
script = ExtResource("7_rule")
path = ExtResource("3_path2")
unlock_from_wave = 5

[sub_resource type="Resource" id="Rule_p3"]
script = ExtResource("7_rule")
path = ExtResource("4_path3")
