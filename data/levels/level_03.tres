level_hp_multiplier = 2.0
level_speed_multiplier = 1.3
level_core_damage_multiplier = 1.5
wave_scaling = ExtResource("6_scaling")
enemy_pool = Array[InsectData]([ExtResource("5_enemy")])
grid_path = ExtResource("2_path")
