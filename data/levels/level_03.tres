[resource]
script = ExtResource("1_level")
level_id = &"level_03"
display_name = "Level 3"
description = "Higher baseline. Three infection channels — Path 2 from wave 5, Path 3 from wave 10."
grid_columns = 18
grid_rows = 10
cell_size = Vector2(64, 64)
starting_bio_energy = 100.0
nucleus_max_health = 100.0
