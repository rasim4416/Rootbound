[gd_resource type="Resource" script_class="ResearchData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/research/research_data.gd" id="1_research"]
[ext_resource type="Script" path="res://scripts/research/research_cost.gd" id="2_cost"]
[ext_resource type="Resource" path="res://data/research/elements/carbon.tres" id="3_c"]
[ext_resource type="Script" path="res://scripts/progression/stat_modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Cost_c"]
script = ExtResource("2_cost")
element = ExtResource("3_c")
amount = 10

[sub_resource type="Resource" id="Mod_prod"]
script = ExtResource("4_mod")
stat_id = &"bio_energy_production_amount"
modifier_type = 0
value = 1.0

[resource]
script = ExtResource("1_research")
research_id = &"generator_production"
display_name = "Production"
description = "Generator Bio-Energy production +1 per tick."
costs = Array[ResearchCost]([SubResource("Cost_c")])
unlocked_by_default = false
unlockable = true
permanent_modifiers = Array[StatModifier]([SubResource("Mod_prod")])
