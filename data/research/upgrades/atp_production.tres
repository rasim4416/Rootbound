[gd_resource type="Resource" script_class="ResearchData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/research/research_data.gd" id="1_research"]
[ext_resource type="Script" path="res://scripts/research/research_cost.gd" id="2_cost"]
[ext_resource type="Resource" path="res://data/research/elements/nitrogen.tres" id="3_n"]
[ext_resource type="Script" path="res://scripts/progression/stat_modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Cost_n"]
script = ExtResource("2_cost")
element = ExtResource("3_n")
amount = 10

[sub_resource type="Resource" id="Mod_atp"]
script = ExtResource("4_mod")
stat_id = &"atp_generation"
modifier_type = 0
value = 1.0

[resource]
script = ExtResource("1_research")
research_id = &"atp_production"
display_name = "ATP Production"
description = "Permanent +1 ATP/sec global generation."
costs = Array[ResearchCost]([SubResource("Cost_n")])
unlocked_by_default = false
permanent_modifiers = Array[StatModifier]([SubResource("Mod_atp")])
